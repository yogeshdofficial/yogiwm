# Generated by Cargo
# Will have compiled files and executables across workspace and sub-crates
**/target/

# Remove Cargo.lock from gitignore if creating an executable/binary in the workspace;
# leave it ignored if the workspace only contains libraries
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Rustc internal compiler error stack traces
rustc-ice-*.txt

# Mutation testing data (cargo-mutants)
**/mutants.out*/

# Optional: IDE / Editor folders
# .vscode/
# .idea/
